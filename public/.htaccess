# Disable directory browsing
Options -Indexes

# =====================================================
# Untuk server DENGAN mod_rewrite (ideal)
# =====================================================
<IfModule mod_rewrite.c>
    Options +FollowSymlinks
    RewriteEngine On
    RewriteBase /DataInvest/public/
    
    # Pengecualian untuk file statis
    RewriteCond %{REQUEST_URI} !^/DataInvest/public/assets/
    RewriteCond %{REQUEST_URI} !^/DataInvest/public/uploads/
    RewriteCond %{REQUEST_URI} !^/DataInvest/public/favicon\.ico
    
    # Redirect ke index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L,NC,QSA]
</IfModule>

# =====================================================
# Fallback untuk server TANPA mod_rewrite
# =====================================================
# Arahkan semua 404 ke index.php
<IfModule !mod_rewrite.c>
    ErrorDocument 404 /DataInvest/public/index.php
</IfModule>

# Enable MultiViews sebagai alternatif
<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

# Disable server signature
ServerSignature Off

