# Disable directory browsing
Options -Indexes

# Untuk server TANPA mod_rewrite
# Arahkan semua request ke simple.php

<IfModule mod_rewrite.c>
    # Jika mod_rewrite aktif, gunakan ini
    RewriteEngine On
    RewriteBase /DataInvest/public/
    
    # Jika ada file/folder nyata, lewati
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Arahkan ke simple.php dengan path
    RewriteRule ^(.*)$ simple.php/$1 [L]
</IfModule>

# Fallback untuk server TANPA mod_rewrite
# Langsung akses simple.php di URL
DirectoryIndex simple.php

# Allow access to assets folder directly
<IfModule mod_rewrite.c>
    RewriteRule ^assets/.*$ - [L]
    RewriteRule ^uploads/.*$ - [L]
    RewriteRule ^favicon\.ico$ - [L]
</IfModule>

# Disable server signature
ServerSignature Off

