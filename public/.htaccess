# Disable directory browsing
Options -Indexes

# ----------------------------------------------------------------------
# Untuk server DENGAN mod_rewrite
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
    Options +FollowSymlinks
    RewriteEngine On
    
    # Redirect root ke public folder (dari root .htaccess)
    RewriteBase /DataInvest/public/

    # Pengecualian untuk file statis
    RewriteCond %{REQUEST_URI} !^/public/assets/
    RewriteCond %{REQUEST_URI} !^/public/uploads/
    RewriteCond %{REQUEST_URI} !^/public/favicon\.ico
    RewriteCond %{REQUEST_URI} !^/assets/
    RewriteCond %{REQUEST_URI} !^/uploads/
    RewriteCond %{REQUEST_URI} !^/favicon\.ico

    # JANGAN rewrite jika sudah ada index.php di URL (mencegah loop)
    RewriteCond %{REQUEST_URI} !^/index\.php

    # Jika file/folder nyata tidak ditemukan, arahkan ke index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>

# ----------------------------------------------------------------------
# Untuk server TANPA mod_rewrite
# Gunakan query string: index.php?r=/dashboard
# ----------------------------------------------------------------------
<IfModule !mod_rewrite.c>
    # Enable query strings untuk routing
    # URL: index.php?r=/dashboard
    RewriteEngine Off
</IfModule>

# Disable server signature
ServerSignature Off

