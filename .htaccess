# Redirect all requests to public directory
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Redirect root to public folder
    RewriteRule ^$ public/simple.php [L]
    RewriteRule ^(.*)$ public/simple.php [L]
</IfModule>

# Fallback untuk server TANPA mod_rewrite
# Langsung akses simple.php
<IfModule !mod_rewrite.c>
    RedirectMatch 307 ^/$ /DataInvest/public/simple.php/
</IfModule>

